;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Night Heist"
run/main_scene="res://game/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://game/icon.png"

[autoload]

EventBus="*uid://d3kctb7bv2ygb"
MapManager="*uid://brksnu4vxh1h8"
Constants="*uid://dpksr2ro7fjd6"
AudioManager="*uid://bfd7rkvafibty"
DebugSettings="*res://shared/debug_settings.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=296
window/size/window_width_override=800
window/size/window_height_override=592
window/stretch/mode="canvas_items"

[global_group]

thief=""
guard=""

