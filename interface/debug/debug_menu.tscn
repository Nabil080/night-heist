[node name="DebugMenu" type="CanvasLayer"]
script = ExtResource("menu")
process_mode = 3
layer = 20

[node name="DebugOverlay" type="Node2D" parent="."]
visible = false
script = ExtResource("overlay")

[node name="Panel" type="PanelContainer" parent="."]
